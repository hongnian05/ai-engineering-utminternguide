# UTM-InternGuide Environment Configuration
# Copy this file to `.env` and fill in your API key if you want LLM-synthesized responses.
# Never commit `.env` to GitHub.

# Optional: OpenAI API key for LLM answer synthesis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Google Gemini API key (alternative LLM backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
